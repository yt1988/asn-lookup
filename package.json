{
  "name": "asn-lookup",
  "private": true,
  "type": "module",
  "description": "IP and ASN lookup: which network announces an address, and every autonomous system's prefixes, upstreams, registry record and sibling ASNs, one page per AS",
  "scripts": {
    "data": "node scripts/data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check && node --test \"test/*.test.mjs\"",
    "dev": "npx wrangler dev --port 8798",
    "deploy": "npx wrangler deploy",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "0.25.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yt1988/asn-lookup"
  },
  "homepage": "https://asn.1ms.dog"
}
